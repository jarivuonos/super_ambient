# Kopioi tiedostoksi .env.local. Älä tallenna salaisuuksia versionhallintaan.

# FHIR-palvelin (oletus: julkinen HAPI R4 -testipalvelin)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_TIMEOUT_MS=20000

# Kielimalli: mock | jev | none
#  mock = sääntöpohjainen demotila (ei kielimalli)
#  jev  = Jev (TypeSafe System One) tulkitsee KYSYMYKSET. Jev ei kirjoita tekstiä, joten vastaus
#         koostetaan faktoista ja litteraatin rakenteistus on edelleen mock-sääntöpohjainen.
#  none = ei mallipalvelua
LLM_PROVIDER=mock

# Jev-yhteys (vain kun LLM_PROVIDER=jev). Avain pysyy palvelimella; älä liitä sitä keskusteluihin.
TYPESAFE_API_KEY=
# Valinnaiset (oletukset: https://api.typesafe.ai/v1/systemone ja jev-latest). Endpointin tulee olla https.
LLM_ENDPOINT=
LLM_MODEL=
# Vanha nimi toimii varavaihtoehtona, jos TYPESAFE_API_KEY puuttuu.
LLM_API_KEY=

# Litteraatin rakenteistus (vain kun LLM_PROVIDER=jev): mock (oletus) | jev
#  jev = LÄHETTÄÄ litteraatin lauseet Typesafelle luokiteltaviksi (ei potilastunnisteita).
#        Käytä vain synteettisellä harjoituspuheella, kunnes tietojenkäsittelyehdot on tarkistettu.
LLM_STRUCTURING=mock
# Samanaikaiset Jev-pyynnöt (1–8). Oletus 1 sopii alimpaan tilaukseen; nosta tilauksen sallimaan määrään.
JEV_CONCURRENCY=1

# Litterointi: none (oletus). Palvelukohtainen adapteri lisätään dokumentaation perusteella.
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_ENDPOINT=
TRANSCRIPTION_API_KEY=
